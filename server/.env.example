# ===== Servidor =====
PORT=4000
CLIENT_URL=http://localhost:5173

# ===== MongoDB =====
# Use o MongoDB Atlas ou local. Exemplos:
# Opção 1 (recomendado se DNS SRV funcionar):
# MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/esentinel2?retryWrites=true&w=majority
# Opção 2 (Windows/rede sem SRV — use o host PRIMÁRIO do Atlas, ex: shard-00-02):
# MONGODB_URI=mongodb://usuario:senha@ac-xxxx-shard-00-02.xxxxx.mongodb.net:27017/esentinel2?ssl=true&authSource=admin&directConnection=true&retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/esentinel2

# ===== Cloudinary =====
# Crie uma conta gratuita em https://cloudinary.com/ e copie as credenciais.
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret
CLOUDINARY_FOLDER=esentinel2
