{
  "name": "esentinel2",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "install:all": "npm install --include=dev && npm install --include=dev --prefix client",
    "build": "npm run build:server && npm run build:client",
    "build:server": "npx tsc -p server/tsconfig.json",
    "build:client": "npm run build --prefix client",
    "start": "cross-env NODE_ENV=production node server/dist/index.js",
    "dev": "node scripts/dev.mjs",
    "deploy": "npm run install:all && npm run build && npm run start",
    "seed": "npm run seed --prefix server",
    "vercel-build": "npm run build"
  },
  "dependencies": {
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "serverless-http": "^3.2.0",
    "streamifier": "^0.1.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/streamifier": "^0.1.2",
    "cross-env": "^7.0.3",
    "typescript": "^5.7.3"
  }
}
